// =====================================================================
// Arbetsbegäran / Driftorder - datamodell
// Klistra in på https://dbdiagram.io för att visualisera.
// =====================================================================

// ---------- Enums ----------

Enum user_role {
  applicant   [note: 'Ansökande']
  shiftlead1  [note: 'Driftledare 1']
  shiftlead2  [note: 'Driftledare 2']
  controlroom [note: 'Kontrollrum']
}

Enum work_phase {
  arbetsbegaran [note: 'Arbetsbegäran']
  driftorder    [note: 'Driftorder']
}

Enum work_status {
  draft           [note: 'Utkast']
  submitted       [note: 'Inskickad']
  review          [note: 'Granskning']
  needs_more_info [note: 'Komplettering']
  approved        [note: 'Godkänd']
  rejected        [note: 'Avslagen']
  planned         [note: 'Planerad']
  ready           [note: 'REDO']
  completed       [note: 'Avslutad']
}

Enum work_priority {
  low
  medium
  high
  critical
}

Enum document_format {
  docx
  pdf
}

// ---------- Kärntabeller ----------

Table users {
  id         uuid        [pk, default: `gen_random_uuid()`]
  name       varchar(120) [not null]
  email      varchar(255) [not null, unique]
  role       user_role    [not null]
  active     boolean      [not null, default: true]
  created_at timestamptz  [not null, default: `now()`]

  Note: 'Användare med en roll i flödet (ansökande, driftledare, kontrollrum).'
}

Table facilities {
  id         uuid         [pk, default: `gen_random_uuid()`]
  name       varchar(160) [not null, unique]
  created_at timestamptz  [not null, default: `now()`]

  Note: 'Anläggning, t.ex. "Anläggning A - Reaktor 1".'
}

Table facility_objects {
  id          uuid         [pk, default: `gen_random_uuid()`]
  facility_id uuid         [not null, ref: > facilities.id]
  designation varchar(80)  [not null, note: 'Objektsbeteckning, t.ex. "T2-L3"']
  description varchar(255)
  created_at  timestamptz  [not null, default: `now()`]

  Indexes {
    (facility_id, designation) [unique]
  }
  Note: 'Objekt/utrustning som tillhör en anläggning.'
}

Table work_items {
  id                uuid          [pk, default: `gen_random_uuid()`]
  reference_no      varchar(20)   [not null, unique, note: 'Läsbart nr, t.ex. "ARB-1001"']
  title             varchar(200)  [not null]
  description       text
  phase             work_phase    [not null]
  status            work_status   [not null, default: 'draft']
  priority          work_priority [not null, default: 'medium']

  facility_id       uuid          [not null, ref: > facilities.id]
  object_id         uuid          [ref: > facility_objects.id]

  requested_start   date
  duration          varchar(60)   [note: 'Fritext, t.ex. "4 timmar"']
  risk_impact       text

  // En driftorder skapas från en godkänd arbetsbegäran (självreferens).
  source_request_id uuid          [ref: > work_items.id]

  created_by        uuid          [not null, ref: > users.id]
  assigned_to       uuid          [ref: > users.id]

  created_at        timestamptz   [not null, default: `now()`]
  updated_at        timestamptz   [not null, default: `now()`]

  Indexes {
    status
    phase
    facility_id
    (phase, status)
  }
  Note: 'Arbetsbegäran OCH driftorder i samma tabell, åtskilda via phase.'
}

// ---------- Beroende tabeller (per work_item) ----------

Table requisites {
  id           uuid         [pk, default: `gen_random_uuid()`]
  work_item_id uuid         [not null, ref: > work_items.id]
  label        varchar(200) [not null]
  fulfilled    boolean      [not null, default: false]
  note         varchar(255)
  sort_order   int          [not null, default: 0]

  Note: 'Förutsättningar / checklista (gate-punkter).'
}

Table activity_entries {
  id           uuid        [pk, default: `gen_random_uuid()`]
  work_item_id uuid        [not null, ref: > work_items.id]
  actor_id     uuid        [ref: > users.id, note: 'Null när aktören är "System"']
  actor_name   varchar(120) [not null, note: 'Snapshot av namn/System vid tillfället']
  role         user_role   [not null]
  action       text        [not null]
  comment      text
  created_at   timestamptz [not null, default: `now()`]

  Indexes {
    (work_item_id, created_at)
  }
  Note: 'Aktivitetslogg / historik.'
}

Table attachments {
  id           uuid         [pk, default: `gen_random_uuid()`]
  work_item_id uuid         [not null, ref: > work_items.id]
  name         varchar(255) [not null]
  file_type    varchar(40)  [not null, note: 'word, pdf, ...']
  size_bytes   bigint
  storage_url  text         [not null]
  version      int          [not null, default: 1]
  uploaded_by  uuid         [not null, ref: > users.id]
  uploaded_at  timestamptz  [not null, default: `now()`]

  Note: 'Bifogade filer, t.ex. Word-dokument för en driftorder.'
}

Table document_versions {
  id           uuid            [pk, default: `gen_random_uuid()`]
  work_item_id uuid            [not null, ref: > work_items.id]
  name         varchar(255)    [not null]
  version      int             [not null, default: 1]
  format       document_format [not null]
  storage_url  text
  generated_by varchar(120)    [not null, note: 'System eller användarnamn']
  generated_at timestamptz     [not null, default: `now()`]

  Indexes {
    (work_item_id, version)
  }
  Note: 'Genererade dokumentversioner (ARB.BEG #1001 v1, v2 ...).'
}

Table approvals {
  id            uuid        [pk, default: `gen_random_uuid()`]
  work_item_id  uuid        [not null, ref: > work_items.id]
  role          user_role   [not null, note: 'Vilken roll som ska godkänna']
  approver_id   uuid        [ref: > users.id]
  approver_name varchar(120) [not null]
  approved      boolean     [not null, default: false]
  decided_at    timestamptz
  sort_order    int         [not null, default: 0]

  Note: 'Godkännare per ärende och deras beslut.'
}

Table notifications {
  id           uuid        [pk, default: `gen_random_uuid()`]
  recipient_id uuid        [not null, ref: > users.id]
  work_item_id uuid        [ref: > work_items.id]
  type         varchar(60) [not null, note: 't.ex. komplettering_begard']
  message      text        [not null]
  read         boolean     [not null, default: false]
  created_at   timestamptz [not null, default: `now()`]

  Indexes {
    (recipient_id, read)
  }
  Note: 'Notiser, t.ex. till Driftledare 1 när komplettering begärs.'
}
